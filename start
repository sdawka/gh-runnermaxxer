#!/usr/bin/env bash
# One command to run gh-runnermaxxer: builds bin/runnermaxxer if it is missing
# or older than its sources, then runs it on this directory. The program does
# the rest (first-run setup, the runner download, supervising the runners
# while it is open).
#
# Extra arguments are passed through, e.g. ./start --no-unicode
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$ROOT/bin/runnermaxxer"

if [[ ! -x "$BIN" ]] || [[ -n "$(find "$ROOT/cmd" "$ROOT/internal" "$ROOT/go.mod" "$ROOT/go.sum" \( -name '*.go' -o -name go.mod -o -name go.sum \) -newer "$BIN" -print -quit)" ]]; then
    command -v go >/dev/null || { echo "start: Go is needed to build runnermaxxer - install it from https://go.dev/dl/" >&2; exit 1; }
    echo "Building runnermaxxer..."
    make -s -C "$ROOT" build
fi

exec "$BIN" --dir "$ROOT" "$@"
