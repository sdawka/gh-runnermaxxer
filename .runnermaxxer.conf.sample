# gh-runnermaxxer configuration
# Copy this file to .runnermaxxer.conf and edit as needed

# Projects (repositories/organizations) are NOT configured here: list them
# in .runnermaxxer.targets (see .runnermaxxer.targets.sample) or add them
# from the project menu at startup. A legacy REPO_URL/ORG_URL in this file
# is migrated into the targets file automatically.

# Runner naming prefix (default: hostname)
# Runners will be named: prefix-1, prefix-2, etc.
RUNNER_NAME_PREFIX="my-runner"

# Maximum number of runners allowed across all projects (default: 20)
MAX_RUNNERS="20"

# Seconds between UI refreshes / supervisor ticks (default: 5)
REFRESH_INTERVAL="5"

# Crashed runners are restarted with exponential backoff (5s, 10s, 20s, ...).
# After this many consecutive rapid crashes the runner is quarantined until
# manually started again (default: 5)
MAX_RESTART_ATTEMPTS="5"

# Runner logs are truncated (keeping a .1 copy) past this size (default: 10)
MAX_LOG_SIZE_MB="10"

# Every N supervisor ticks, cross-check runners against the GitHub API and
# recycle any that GitHub reports offline while the local process is alive.
# Set to 0 to disable (default: 12, i.e. every ~60s)
GH_HEALTH_TICKS="12"

# Share one tool cache ($RUNNER_BASE_DIR/.toolcache) across all runners, so
# actions like setup-node download a toolchain once instead of per runner.
# Sets RUNNER_TOOL_CACHE and AGENT_TOOLSDIRECTORY for each runner.
# Takes effect as runners (re)start. Deleting .toolcache is safe (default: 1)
SHARED_TOOL_CACHE="1"

# Register NEW runners as ephemeral (--ephemeral): each takes exactly one
# job, then GitHub deletes its registration and the manager re-registers it
# in the same directory for the next job. Existing runners keep the mode
# they were set up with; remove and re-add them to switch (default: 0)
EPHEMERAL_RUNNERS="0"

# Autoscale projects that have min=/max= bounds in .runnermaxxer.targets
# (e.g. "owner/repo min=1 max=5") from GitHub's queue of workflow runs.
# Runs after each GitHub poll, so GH_HEALTH_TICKS must be > 0. Projects
# without bounds keep their fixed count (default: 0)
AUTOSCALE="0"

# Minutes an autoscaled project must have an idle runner before one is
# removed (at most one per period, never below min) (default: 10)
AUTOSCALE_IDLE_MINUTES="10"
